DATABASE_URL=sqlite:///./data/lead_radar.db
POSTGRES_USER=radar
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=radar
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=45
CONTENT_PROVIDER=douyin-playwright
API_AUTH_TOKEN=
# 只在 Next.js 服务端代理中使用，不要改成 NEXT_PUBLIC_API_TOKEN。
API_URL=http://127.0.0.1:8689
SETTINGS_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOUYIN_COMMENTS_CRAWLER_URL=http://127.0.0.1:8000
MEDIACRAWLER_PATH=
SOCIAL_HARVEST_PATH=
DOUYIN_PROFILE_DIR=./data/browser/douyin
DOUYIN_HEADLESS=false
DOUYIN_BROWSER_CHANNEL=chromium
# Optional. Chromium otherwise inherits HTTPS_PROXY/HTTP_PROXY/ALL_PROXY.
DOUYIN_PROXY_SERVER=
DOUYIN_DEFAULT_COMMENT_LIMIT=100
AUTO_REPLY_ENABLED=false
AUTO_REPLY_MAX_PER_HOUR=10
AUTO_REPLY_MAX_PER_DAY=50
AUTO_REPLY_MIN_INTERVAL_SECONDS=30
